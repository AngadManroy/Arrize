# ---------- Database ----------
# Postgres connection string (Neon/Supabase/Render/Replit). Leave empty to use embedded PGlite in ./.data
# (fine locally; NOT persistent on serverless/autoscale deploys).
DATABASE_URL=

# ---------- Session (demo-grade sign-in) ----------
SESSION_SECRET=                   # any long random string: openssl rand -hex 24

# ---------- LLM ----------
LLM_PROVIDER=openrouter           # openrouter | openai
LLM_MODEL=anthropic/claude-haiku-5.5   # fast + cheap; free option: poolside/laguna-s-2.1:free
LLM_FALLBACK_MODELS=openai/gpt-4o-mini,google/gemini-2.5-flash-lite   # tried in order if the main model fails
OPENROUTER_API_KEY=
OPENAI_API_KEY=
# No key at all → every agent and coach reply uses the built-in mock (recorded as provider "mock").

# ---------- Agents ----------
AGENT_PROVIDER=local              # local | agenticorg
AGENTICORG_BASE_URL=https://agenticorg.hackathon.pinelabs.com   # Pine Labs hackathon tenant
AGENTICORG_API_KEY=
AGENTICORG_COMPANY_ID=
AGENTICORG_AGENT_GOAL_INTAKE=     # printed by: npm run agents:create
AGENTICORG_AGENT_QUEST_PLANNER=
AGENTICORG_AGENT_DEATH_QUEST_OPTIONS=
AGENTICORG_ACCEPT_HITL=true       # use shadow-mode (flagged) output that passes validation; false = fall back to the LLM
AGENTICORG_AGENT_DEATH_QUEST=     # Death Quest validator

# ---------- Arrize Pro (₹199/month by UPI QR) ----------
UPI_VPA=                          # the UPI ID that receives payments, e.g. yourname@okaxis. Empty = upgrade button hidden
UPI_PAYEE_NAME=Arrize             # shown in the payer's UPI app

# ---------- Voice coach (optional) ----------
# Without a key the browser's own speech recognition and voice are used (Chrome, Edge, Safari).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=              # default 21m00Tcm4TlvDq8ikWAM
ELEVENLABS_TTS_MODEL=             # default eleven_flash_v2_5
ELEVENLABS_STT_MODEL=             # default scribe_v1

# ---------- Telegram (not used in this build) ----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# ---------- Ops ----------
CRON_SECRET=                      # Authorization: Bearer <CRON_SECRET> for /api/cron/daily-reset
ADMIN_PASSWORD=                   # /admin
APP_URL=http://localhost:3000
DEMO_DAY_MINUTES=                 # optional: a "day" lasts N minutes (live demo of the reset)
DEMO_EPOCH=                       # optional ISO time the demo clock starts (default: first use, stored in DB)
