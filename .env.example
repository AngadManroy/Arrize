# --- Database ---
# Postgres connection string (Replit/Neon/Supabase/Render). Leave empty to use the
# built-in PGlite database stored in ./.data (fine for dev; not persistent on autoscale deploys).
DATABASE_URL=

# --- Public URL of this app (used for payment callbacks and mock checkout) ---
APP_URL=http://localhost:3000

# --- Admin (Guild Master) ---
# Required header/query key for /admin and /api/admin/*. Leave empty only in local dev.
ADMIN_KEY=change-me

# --- Quest Architect: AgenticOrg (primary) ---
AGENTICORG_BASE_URL=https://app.agenticorg.ai
AGENTICORG_API_KEY=
AGENTICORG_AGENT_ID=
# Optional: company UUID if your tenant requires it on runs
AGENTICORG_COMPANY_ID=

# --- Quest Architect fallback + chat layer: Anthropic Claude ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Pine Labs Online (Plural) ---
# UAT: https://pluraluat.v2.pinepg.in   Production: https://api.pluralpay.in
PINE_BASE_URL=https://pluraluat.v2.pinepg.in
PINE_CLIENT_ID=
PINE_CLIENT_SECRET=
# Leave both Pine Labs keys empty to use the built-in mock checkout.
